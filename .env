# Paperless-ng
PNGX_BASE=https://<domain.tld>
PNGX_TOKEN=token_here
# Open WebUI
OWUI_BASE=<https://<domain.tld>
OWUI_TOKEN=token_here
KB_ID=<uuid of knowledge base>

# Elastic APM
ELASTIC_SERVICE_NAME='paperless-sync-openwebui'
ELASTIC_SECRET='<token_here>'
ELASTIC_APM_URL='http://domain.tld:port'
ELASTIC_ENVIRONMENT='my-environment'

# Output & options
OUT_DIR=/app/data
PAGE_SIZE=100
PAR_J=4
LIMIT_DOCS=0     # 0 = no limit

# Optional: logging level
LOG_LEVEL=INFO
